# Bundle only OpenMP; leave system C/C++ runtimes to the platform.
set(_lib "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_LIBDIR@/@CMAKE_SHARED_LIBRARY_PREFIX@myproject@CMAKE_SHARED_LIBRARY_SUFFIX@")
if(WIN32)
    set(_lib "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@/myproject.dll")
    set(_dest "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@")
else()
    set(_dest "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_LIBDIR@")
endif()
if(WIN32)
    set(_runtime "@_omp_redist@/vcomp140.dll")
    if(NOT EXISTS "${_runtime}")
        message(FATAL_ERROR "MSVC redistributable OpenMP runtime not found: ${_runtime}")
    endif()
    file(INSTALL "${_runtime}" DESTINATION "${_dest}")
    return()
elseif(APPLE)
    set(_runtime "@OpenMP_omp_LIBRARY@")
    if(NOT EXISTS "${_runtime}")
        message(FATAL_ERROR "libomp not found: ${_runtime}")
    endif()
    get_filename_component(_name "${_runtime}" NAME)
    file(INSTALL "${_runtime}" DESTINATION "${_dest}" FOLLOW_SYMLINK_CHAIN)
    execute_process(COMMAND otool -L "${_lib}" OUTPUT_VARIABLE _links COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCH "[^ \t\n]+libomp[^ \t\n]*\\.dylib" _old "${_links}")
    if(NOT _old)
        message(FATAL_ERROR "Installed library has no libomp load command")
    endif()
    execute_process(COMMAND install_name_tool -change "${_old}"
        "@loader_path/${_name}" "${_lib}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND codesign --force --sign - "${_lib}" COMMAND_ERROR_IS_FATAL ANY)
    return()
endif()
file(GET_RUNTIME_DEPENDENCIES LIBRARIES "${_lib}"
    RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved
    PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
    POST_INCLUDE_REGEXES ".*[/\\\\](libgomp[^/\\\\]*|libomp[^/\\\\]*|vcomp[0-9]+\\.dll)$"
    POST_EXCLUDE_REGEXES ".*")
set(_count 0)
foreach(_runtime IN LISTS _resolved)
    get_filename_component(_name "${_runtime}" NAME)
    if(_name MATCHES "^(libgomp|libomp|vcomp)")
        file(INSTALL "${_runtime}" DESTINATION "${_dest}" FOLLOW_SYMLINK_CHAIN)
        math(EXPR _count "${_count}+1")
    endif()
endforeach()
if(NOT _count EQUAL 1)
    message(FATAL_ERROR "Expected one OpenMP runtime, found ${_count}; unresolved: ${_unresolved}")
endif()
